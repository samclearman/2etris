{
  "name": "2etris",
  "version": "1.0.1",
  "description": "A fun multiplayer game",
  "private": true,
  "scripts": {
    "test": "tsc -p tests/tsconfig.json && node --test tests/build/tests/*.test.js",
    "build": "mkdir -p dist && cp -R static/. dist/ && webpack --mode production",
    "preview": "serve -l 8000 dist",
    "start": "concurrently --kill-others 'fswatch -0or static | xargs -0 -n 1 -I {} rsync -r -u static/* dist/' 'webpack -w' 'serve -l 8000 dist'"
  },
  "author": "Sam Clearman",
  "license": "ISC",
  "dependencies": {
    "@types/seedrandom": "*",
    "firebase": "10.x",
    "seedrandom": "*",
    "ts-loader": "*",
    "typescript": "5.x",
    "webpack": "5.x"
  },
  "devDependencies": {
    "concurrently": "*",
    "serve": "*",
    "webpack-cli": "*"
  }
}
