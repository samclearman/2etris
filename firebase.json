{
  "database": { "rules": "database.rules.json" },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "database": { "host": "127.0.0.1", "port": 9000 },
    "ui": { "enabled": false }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [ {
        "source": "/game",
        "destination": "/game.html"
    } ]
  }
}
